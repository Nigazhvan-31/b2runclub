# Leave unset for local development — Vite proxies /api and /health to the
# Express backend (see vite.config.ts), so the browser stays on one origin.
#
# Set this only when the built frontend is served from a different origin than
# the API, e.g. a static host talking to a deployed backend.
# VITE_API_BASE_URL=https://api.example.com

# Where `npm run dev` should proxy to, if the backend is not on :3000.
# BACKEND_URL=http://localhost:3000

# Razorpay publishable key id (safe to ship to the browser — the secret stays
# on the backend in runclub-backend/.env).
#
# Registering for a paid event gets the key from the register response, so this
# is only needed for the "Pay now" button that resumes an order left PENDING.
# Must be the same key id as RAZORPAY_KEY_ID in the backend .env.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
