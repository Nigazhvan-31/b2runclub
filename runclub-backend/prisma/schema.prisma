// file: runclub-backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// User role representation: "ADMIN", "MEMBER", "VOLUNTEER", "VISITOR"
// Event status representation: "DRAFT", "PUBLISHED", "ARCHIVED"
// Payment status representation: "PENDING", "PAID", "FAILED", "FREE"

// USER SERVICE Data
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("MEMBER")
  created_at    DateTime @default(now())
  emergency_contact String?

  /// The member's own number, E.164. Distinct from emergency_contact, which is
  /// somebody else's — on race day we need both, and conflating them means
  /// ringing the wrong person.
  ///
  /// Required at signup but not verified: the club has no way to send a code to
  /// it. There is deliberately no phone_verified_at to go with it — a column
  /// nothing ever writes would read as "these numbers are confirmed" to the
  /// next person looking at an organiser screen, which would be worse than
  /// having no such column at all.
  phone         String?
  /// Null until the address has been proved by a one-time code.
  email_verified_at DateTime?

  events_created  Event[] // Admin connection
  registrations  EventRegistration[]
  posts          Post[]
  votes          PollVote[]
  notifications  Notification[]
  comments       Comment[]
  photos         Photo[]
  reset_tokens   PasswordResetToken[]
  results        EventResult[]
  feedback       EventFeedback[]
  shift_assignments ShiftAssignment[]
  splits         CheckpointSplit[]
  health_workouts HealthWorkout[]
  verification_codes VerificationCode[]
}

/// A one-time code sent to an email address.
///
/// Only an HMAC of the code is stored, following PasswordResetToken. HMAC and
/// not a bare SHA-256 because a six-digit code has only a million possible
/// values: a plain digest of one is trivially reversed from a database dump,
/// whereas the HMAC cannot be computed without the server's key.
///
/// `destination` is kept alongside so a code cannot be redeemed against a
/// different address than the one it was sent to — otherwise a member could
/// request a code to an address they control, change their email, and verify
/// the new one with it.
model VerificationCode {
  id          String    @id @default(uuid())
  user_id     String
  /// Always "EMAIL" today. Kept as a column rather than assumed so a second
  /// channel needs no migration — the removed phone one is at fa37999.
  channel     String
  destination String
  code_hash   String
  expires_at  DateTime
  consumed_at DateTime?
  /// Wrong guesses so far. Capped, so the code cannot be brute-forced online.
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, channel])
}

/// One named person on a booking — the member who booked, plus anyone they
/// brought.
///
/// A row per person rather than adult/kid counters on the registration, because
/// names are required. Counters would have meant storing a number and a separate
/// list of names that could disagree, and race day needs to admit people
/// individually: "two booked, one turned up" is a per-person fact.
///
/// The booking member gets a row too, flagged is_booker. That is the whole
/// reason check-in has one shape instead of two — every attendee is a row with
/// an admitted_at, and the roster is just this list.
model RegistrationGuest {
  id              String    @id @default(uuid())
  registration_id String

  name            String

  /// This participant's own mobile number, E.164.
  ///
  /// Collected per person, not per booking, because it is what the club adds to
  /// the event's WhatsApp group and rings on the day — and the four people on
  /// one booking are four people to reach. The form offers "use the booker's
  /// number" for a child or a partner who has none of their own, which copies
  /// the booker's number in here rather than leaving it null: the roster has to
  /// state a reachable number for every name on it, and a null would read as
  /// "not collected" when the answer is in fact known.
  ///
  /// Nullable only for the bookings taken before this was collected.
  phone           String?

  /// "ADULT" or "KID". Decides which price applied and whether the event had to
  /// allow children.
  kind            String    @default("ADULT")
  /// True for the member who made the booking. They cannot be removed from their
  /// own party, and a volunteer's own place is the one that is comped.
  is_booker       Boolean   @default(false)

  /// Null until they are admitted at the start line. This is what lets a party of
  /// two be half checked in.
  admitted_at     DateTime?
  admitted_by     String?

  created_at      DateTime  @default(now())

  registration    EventRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
}

// HEALTH SYNC Data
// Workouts a member has imported from their phone's health app.
//
// This is an import rather than a live sync on purpose: HealthKit is an on-device
// iOS API with no server endpoint, and Google retired the Fit REST API in favour
// of Android-native Health Connect. Neither can be read from a web backend, so a
// file the member exports themselves is the only route that actually works
// without shipping a native app.
model HealthWorkout {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// "apple_health" or "gpx" — where the row came from.
  source        String
  /// Stable id derived from the workout itself, so re-importing the same export
  /// updates rather than duplicating.
  external_id   String
  activity_type String
  started_at    DateTime
  duration_secs Int
  distance_km   Float?
  energy_kcal   Float?
  /// e.g. "Apple Watch" — useful when a member has several sources.
  device        String?
  created_at    DateTime @default(now())

  @@unique([user_id, external_id])
  @@index([user_id, started_at])
}

// AUTH RECOVERY Data
// Only a hash of the token is stored, so a database leak cannot be used to reset
// anyone's password — the raw token exists solely in the emailed link.
model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// GALLERY SERVICE Data
// Uploaded by admins and volunteers; read-only for everyone else.
model Photo {
  id          String   @id @default(uuid())
  // Path served by the static /uploads route, or an external URL.
  url         String
  caption     String?
  // Optional tie to an event, so the gallery can be grouped by session.
  event_id    String?
  event       Event?   @relation(fields: [event_id], references: [id])
  created_at  DateTime @default(now())

  uploader_id String
  uploader    User     @relation(fields: [uploader_id], references: [id])
}

// CLUB CONTENT Data
// A single row holding the About page copy, edited by admins.
model ClubInfo {
  id            String   @id @default("singleton")
  headline      String   @default("")
  about         String   @default("")
  mission       String   @default("")
  founded       String?
  home_base     String?
  contact_email String?
  instagram     String?
  /// The club's Strava link, shown in the contact section. A full URL rather
  /// than a club id: the value people actually have to hand is a share link
  /// (strava.app.link/…), which no id-based URL template can reconstruct.
  strava_url    String?
  /// Invite URL for the club's WhatsApp community. Editable because WhatsApp
  /// invite links can be reset by a group admin, which retires the old one.
  whatsapp      String?
  /// Looping background video for the home page hero. A URL rather than an
  /// upload: a usable hero clip is several megabytes, and the deployment caps
  /// request bodies at 4.5MB, so uploading one through the API would fail for
  /// exactly the files people actually have. Null falls back to the 3D scene.
  hero_video_url String?
  updated_at    DateTime @updatedAt
}

// Partners and sponsors shown in the home page scroller.
model Collaborator {
  id         String   @id @default(uuid())
  name       String
  // The shout-out revealed on hover.
  blurb      String   @default("")
  logo_url   String?
  website    String?
  tier       String   @default("PARTNER") // PARTNER, SPONSOR, COMMUNITY
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

/// The people who started the club, shown on the home page and editable by
/// admins. A separate table from Collaborator rather than another tier on it:
/// a founder needs a photo, a role and a bio, while a collaborator needs a logo
/// and a website, and overloading one model would leave half its columns null
/// in both directions.
model Founder {
  id         String   @id @default(uuid())
  name       String
  /// "Founder", "Founder & Head Coach" — free text, since clubs invent titles.
  role       String   @default("")
  bio        String   @default("")
  photo_url  String?
  /// Handle, not a URL, matching how ClubInfo.instagram is stored.
  instagram  String?
  /// Full profile or share URL, or a bare athlete id.
  strava     String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

// EVENT SERVICE Data
model Event {
  id          String   @id @default(uuid())
  title       String
  type        String   // Run, Cycle, Party etc.
  date_time   DateTime
  location    String
  price       Float
  status      String @default("DRAFT")

  /// Whether children may be brought to this session at all. Off by default, so
  /// an existing event does not silently start accepting them.
  kids_allowed Boolean @default(false)
  /// Entry per child, when kids_allowed. Null means the organiser has not set
  /// one — the registration route refuses a child in that state rather than
  /// guessing at zero, since "free" and "not decided" are different answers.
  kid_price    Float?

  /// Rupees off a booking that covers more than one person, taken off the whole
  /// total once — not per head, and not only off the guests. Null or 0 means no
  /// group discount on this session. Never lets a total go below zero; a
  /// discount that swallows the fee makes the booking free.
  party_discount Float?

  /// How many people a booking must cover before `party_discount` applies.
  ///
  /// Was a hardcoded 2. An organiser running a family session wants the
  /// discount at three, and one running a couples' event wants it at two, and
  /// neither should need a deployment to say so. Null means fall back to the
  /// club default, so every event created before this keeps behaving as it did.
  discount_min_party Int?

  /// Minutes a booking may sit unpaid before its places go back on sale.
  ///
  /// Null means fall back to the club default (24 hours). Per-event because a
  /// session that fills in an hour cannot afford a day-long hold, while a
  /// trek booked six weeks out can.
  hold_minutes Int?

  /// Free-text brief shown on the event page. Optional.
  description String?
  /// Maximum attendees. Null means no limit, which is the default so existing
  /// events keep behaving exactly as they did before capacity existed.
  capacity    Int?

  /// Cover image, used as the backdrop on the event page and on its card.
  /// Stored as a plain URL so it works with whichever storage driver wrote it
  /// — an upload or an externally hosted image. Null keeps the previous look,
  /// so events created before this existed are unaffected.
  cover_url   String?

  admin_id    String
  created_by  User     @relation(fields: [admin_id], references: [id])

  // Route detail, populated from an uploaded GPX.
  route_gpx_url     String?
  route_distance_km Float?
  route_elevation_m Int?

  registrations EventRegistration[]
  reminders     EventReminder[]
  results       EventResult[]
  feedback      EventFeedback[]
  shifts        EventShift[]
  checkpoints   Checkpoint[]
  photos        Photo[]
  questions     EventQuestion[]
}

/// One organiser-written question asked at registration for a single event.
///
/// Per-event rather than a fixed set of columns because the questions are not
/// predictable: a social night needs a food preference, a badminton mixer needs
/// a playing level, and next month's event will need something nobody has
/// thought of. A column per question would mean a migration each time.
model EventQuestion {
  id       String @id @default(uuid())
  event_id String

  /// What the member is asked, e.g. "Food preference".
  prompt   String
  /// "CHOICE" for a pick-one from `options`, "TEXT" for free text.
  kind     String @default("CHOICE")
  /// The answer choices for a CHOICE question, in display order, JSON-encoded.
  ///
  /// JSON in a text column rather than a child table: these are a short list of
  /// short strings that are always read and written whole, never queried
  /// individually, and a table would add a join to every registration read for
  /// no gain. Empty for a TEXT question.
  options  String @default("[]")
  /// Whether registration is refused without an answer.
  required Boolean @default(false)
  /// Display order within the event's form.
  position Int     @default(0)

  created_at DateTime @default(now())

  event   Event                @relation(fields: [event_id], references: [id], onDelete: Cascade)
  answers RegistrationAnswer[]

  @@index([event_id])
}

/// One member's answer to one question, on one booking.
///
/// Hung off the registration rather than the user: the same person answers
/// differently for different events, and a question only means anything in the
/// context of the booking it was asked on.
model RegistrationAnswer {
  id              String @id @default(uuid())
  registration_id String
  question_id     String

  /// The chosen option, or the typed text. Kept as given so an organiser
  /// editing the option list later cannot rewrite what somebody answered.
  answer          String

  created_at DateTime @default(now())

  registration EventRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  question     EventQuestion     @relation(fields: [question_id], references: [id], onDelete: Cascade)

  /// One answer per question per booking; re-answering updates in place.
  @@unique([registration_id, question_id])
  @@index([registration_id])
}

// RESULTS Data — recorded by an organiser after the event.
model EventResult {
  id          String   @id @default(uuid())
  event_id    String
  user_id     String
  /// Net finish time in seconds. Null for a DNF that still gets a row.
  finish_secs Int?
  distance_km Float?
  position    Int?
  status      String   @default("FINISHED") // FINISHED, DNF, DNS
  notes       String?
  created_at  DateTime @default(now())

  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
}

// FEEDBACK Data — one response per person per event.
model EventFeedback {
  id         String   @id @default(uuid())
  event_id   String
  user_id    String
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
}

// VOLUNTEER SHIFTS Data — marshal posts an organiser needs covered.
model EventShift {
  id            String   @id @default(uuid())
  event_id      String
  title         String
  location_note String?
  /// How many volunteers this post needs.
  capacity      Int      @default(1)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())

  event         Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  assignments   ShiftAssignment[]
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  shift_id   String
  user_id    String
  created_at DateTime @default(now())

  shift      EventShift @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([shift_id, user_id])
}

// LIVE TRACKING Data — marshals tap runners through as they pass a post.
model Checkpoint {
  id         String   @id @default(uuid())
  event_id   String
  name       String
  /// Distance into the route, for ordering and pace maths.
  distance_km Float?
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  splits     CheckpointSplit[]
}

model CheckpointSplit {
  id            String   @id @default(uuid())
  checkpoint_id String
  user_id       String
  recorded_at   DateTime @default(now())
  recorded_by   String?

  checkpoint    Checkpoint @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([checkpoint_id, user_id])
}

// EMAIL REMINDER Data
// An organiser picks one or more offsets per event ("24 hours before"), and each
// registrant gets one email per offset.
model EventReminder {
  id           String   @id @default(uuid())
  event_id     String
  // Hours before the start time that this reminder fires.
  hours_before Int
  created_at   DateTime @default(now())

  event        Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  deliveries   ReminderDelivery[]

  // One reminder per offset per event; stops duplicate rows being created.
  @@unique([event_id, hours_before])
}

// One row per person per reminder. The unique constraint is what guarantees a
// restart, a re-run or an overlapping sweep can never send the same email twice.
model ReminderDelivery {
  id          String   @id @default(uuid())
  reminder_id String
  user_id     String
  sent_at     DateTime @default(now())
  // "SENT" or "FAILED" — failures are recorded so a retry is a deliberate act.
  status      String   @default("SENT")
  error       String?

  reminder    EventReminder @relation(fields: [reminder_id], references: [id], onDelete: Cascade)

  @@unique([reminder_id, user_id])
}

// PAYMENT & REGISTRATION SERVICE Data
model EventRegistration {
  id                  String        @id @default(uuid())
  event_id            String
  user_id             String
  razorpay_order_id   String?       @unique // Referenced in payment flow
  razorpay_payment_id String?
  /// Where this booking stands. One of:
  ///
  ///   PENDING      awaiting payment; its places are held until hold_expires_at
  ///   PAID         settled
  ///   FREE         nothing to pay (a comped volunteer, or a free session)
  ///   FAILED       payment failed, or the booking was refunded
  ///   EXPIRED      unpaid past the hold; places released, member may rebook
  ///   CANCELLED    called off by the participant or on their behalf
  ///   DEACTIVATED  switched off by an organiser
  ///   TEST         created for testing; never counts anywhere real
  ///
  /// The last four are additive. The alternative — renaming PENDING to
  /// AWAITING_PAYMENT to match the wording organisers use — would mean
  /// rewriting live rows and every comparison against them for a change that is
  /// only ever seen as a label, so the display name is applied in the UI and the
  /// stored value left alone.
  status              String        @default("PENDING") // Updated by webhook
  role_at_event       String        @default("MEMBER") // Track participant role
  waiver_signed       Boolean       @default(false)
  // Set when an admin bars this person from the event. Kept separate from
  // `status` so a block never destroys the payment state — unblocking restores
  // the registration exactly as it was.
  blocked_at          DateTime?
  // Set when the QR ticket is scanned at the start line.
  attended_at         DateTime?
  checked_in_by       String?
  // Razorpay refund detail, so a refunded entry is auditable.
  refund_id           String?
  refunded_at         DateTime?
  refund_amount       Float?

  /// What was actually charged, in paise, for the whole party.
  ///
  /// A snapshot, not a calculation. An organiser can edit an event's price after
  /// people have booked, so recomputing at refund time would return a different
  /// number than was taken. Integer paise because that is what Razorpay works
  /// in, and because a Float total of several tickets accumulates error.
  amount_due_paise    Int      @default(0)
  /// The unit prices this booking was priced at, kept for the same reason and so
  /// a receipt can be reconstructed.
  adult_price_at_booking Float @default(0)
  kid_price_at_booking   Float?
  /// The group discount actually applied, in paise. `amount_due_paise` is already
  /// net of it — this is kept so a receipt can show the saving rather than only
  /// the total, and so editing the event's discount later cannot rewrite what a
  /// member was told they saved.
  discount_paise_at_booking Int @default(0)

  /// When an unpaid booking stops holding its places.
  ///
  /// Set at creation for anything PENDING, null once there is nothing to wait
  /// for. Stored rather than derived from a created_at plus a constant, because
  /// the window is per-event and an organiser may change the event's setting
  /// after somebody has booked — the deadline a member was given has to be the
  /// one that is enforced.
  hold_expires_at     DateTime?

  /// When the booking was created. Needed by the payment reminder, which is
  /// timed from the booking rather than from the event.
  created_at          DateTime @default(now())

  /// Set when the hold ran out and the places went back on sale.
  expired_at          DateTime?
  /// Set when a booking was called off or switched off. Which of the two it was
  /// is in `status`; this is when.
  cancelled_at        DateTime?
  /// Free text an organiser can leave against a cancellation, so the next
  /// person to look at the row knows why rather than guessing.
  cancel_reason       String?

  /// When the awaiting-payment nudge went out, so it goes out once.
  payment_reminder_sent_at DateTime?

  /// Everyone this booking covers, the member included.
  guests              RegistrationGuest[]
  /// Answers to the event's questionnaire, if it has one.
  answers             RegistrationAnswer[]

  event               Event         @relation(fields: [event_id], references: [id])
  user                User          @relation(fields: [user_id], references: [id])
}

// FORUM & COMMUNITY SERVICE Data
model Post {
  id              String   @id @default(uuid())
  title           String
  content         String
  is_announcement Boolean  @default(false) // For Admin announcements
  created_at      DateTime @default(now())

  author_id       String
  author          User     @relation(fields: [author_id], references: [id])
  comments        Comment[]
}

// POLLS SERVICE Data
model Poll {
  id         String   @id @default(uuid())
  title      String
  active     Boolean  @default(true)
  options    PollOption[]
  votes      PollVote[]
}

model PollOption {
  id         String @id @default(uuid())
  poll_id    String
  option_text String

  poll       Poll   @relation(fields: [poll_id], references: [id])
  votes      PollVote[]
}

model PollVote {
  id          String @id @default(uuid())
  poll_id     String
  option_id   String
  user_id     String

  // Unique composite constraint prevents multiple votes
  @@unique([user_id, poll_id]) 

  poll        Poll   @relation(fields: [poll_id], references: [id])
  option      PollOption @relation(fields: [option_id], references: [id])
  user        User   @relation(fields: [user_id], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  message    String
  is_read    Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
}

model Comment {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  content    String
  created_at DateTime @default(now())

  post       Post     @relation(fields: [post_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
}

